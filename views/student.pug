extends layout
include mixins

block content
  h1= title
  p Logged in Student ID:
    strong #{id}

  hr
  if message
    p.message= message
  if error
    p.error= error

  +recordTable(student, 'Student Information')

  +offeringActionTable(enrollments, 'Enrolled Courses', `/student/${encodeURIComponent(id)}/drop`, 'Drop', 'Drop')

  +offeringActionTable(available, 'Available Courses', `/student/${encodeURIComponent(id)}/add`, 'Add')

  a(href="/") &larr; Return to Login
