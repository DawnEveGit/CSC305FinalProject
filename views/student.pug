extends layout
include mixins

block content
  h1= title
  p Logged in Student ID:
    strong #{id}

  hr
  +flash(message, error)

  +recordTable(student, 'Student Information')

  - const base = `/student/${encodeURIComponent(id)}`
  - const isUpcoming = (row) => row.Term === currentTerm && row.Year === currentYear

  //- Past enrollments are part of the record, so only upcoming-term courses can be dropped here
  +offeringActionTable(enrollments, 'Enrolled Courses (All Terms)', (row) => isUpcoming(row) ? { action: `${base}/drop`, label: 'Drop', confirm: 'Drop', danger: true } : null)

  +offeringActionTable(upcoming, `Courses Offered ${currentTerm} ${currentYear}`, (row) => row['In Schedule'] === 'Yes' ? { action: `${base}/drop`, label: 'Drop', confirm: 'Drop', danger: true } : { action: `${base}/add`, label: 'Add' })

  a(href="/") &larr; Return to Login
