extends layout
include mixins

block content
  h1= title
  p Logged in Registrar ID:
    strong #{id}

  hr
  +resultTable(offerings, `Course Offerings (${currentTerm})`)

  +resultTable(courses, 'Course Catalog')

  +resultTable(faculty, 'Faculty')

  details
    summary
      h2(style="display: inline;") Students (#{students.length})
    +resultTable(students)

  a(href="/") &larr; Return to Login
