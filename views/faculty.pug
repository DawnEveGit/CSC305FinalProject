extends layout
include mixins

block content
  h1= title
  p Logged in Faculty ID:
    strong #{id}

  hr
  +flash(message, error)

  +recordTable(faculty, 'Faculty Information')

  p Choose a course below to view its students and edit their grades.
  +linkTable(offerings, 'Courses Taught', (row) => `/faculty/${encodeURIComponent(id)}/grades/${row.Offering}`, 'Edit Grades')

  a(href="/") &larr; Return to Login
